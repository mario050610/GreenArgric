# local: Mosquitto trên máy; adafruit: Adafruit IO.
MQTT_PROVIDER=local
MQTT_BROKER=mqtt://127.0.0.1:1883
MQTT_BASE_TOPIC=greenargric
MQTT_USERNAME=
MQTT_PASSWORD=

# Chỉ bắt buộc khi MQTT_PROVIDER=adafruit.
AIO_USERNAME=
AIO_KEY=
SERIAL_PORT=
SERIAL_BAUD=115200
SERIAL_TIMEOUT=0.1
AREA_ID=1
PUBLISH_INTERVAL_SECONDS=20

FEED_TEMPERATURE=ga-temperature
FEED_HUMIDITY=ga-humidity
FEED_LIGHT=ga-light
FEED_WATER_LEVEL=ga-water-level
FEED_SOIL_MOISTURE=ga-soil-moisture
FEED_DISTANCE=ga-distance
FEED_PH=ga-ph
FEED_EC=ga-ec
FEED_PUMP_COMMAND=ga-pump-control
FEED_LIGHT_COMMAND=ga-light-control
FEED_FAN_COMMAND=ga-fan-control
FEED_DOSING_PUMP_COMMAND=ga-dosing-pump-control
FEED_PUMP_STATUS=ga-pump-status
FEED_LIGHT_STATUS=ga-light-status
FEED_FAN_STATUS=ga-fan-status
FEED_DOSING_PUMP_STATUS=ga-dosing-pump-status
FEED_GATEWAY_STATUS=ga-gateway-status
